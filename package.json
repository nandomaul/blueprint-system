{
  "name": "adfriends-personnel-blueprint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.ts",
    "build": "npm run typecheck && vite build && node scripts/portable.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5174 --strictPort",
    "checkpoint": "node scripts/checkpoint.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "24.10.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.4",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.2.1"
  }
}
