{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true, "noEmit": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "types": ["node", "vite/client"]
  },
  "include": ["src", "tests", "vite.config.ts"]
}
